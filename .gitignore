__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
wandb/
outputs/

# images/: MNIST is downloaded by scripts/prepare_data.py; runs and samples are regenerated.
/images/data/
/images/logs/

# antibodies/: datasets are built locally by run/prepare_data.sh (OAS95 is ~26GB compressed)...
/antibodies/data/*
# ...except the pinned IMGT germline FASTAs that define the V-gene labels. The BLAST
# databases built from them are derived files and stay ignored.
!/antibodies/data/igblast_germline/
/antibodies/data/igblast_germline/*
!/antibodies/data/igblast_germline/human_raw/
!/antibodies/data/igblast_germline/optional_file/
# Training runs, samples, metrics and weights are regenerated locally (weights are a release asset).
/antibodies/logs/

# synthetic/: figures are regenerated by the notebooks.
/synthetic/figures/
